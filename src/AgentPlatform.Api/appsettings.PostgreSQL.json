{
  "Database": {
    "Type": "postgresql"
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Database=agent_platform;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tenant": {
    "DefaultTenantId": "00000000-0000-0000-0000-000000000001"
  },
  "ModelClient": {
    "Provider": "OpenAI"
  },
  "OpenAI": {
    "Key": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini"
  },
  "Router": {
    "Candidates": [
      { "ModelId": "gpt-4o-mini", "Provider": "openai", "Priority": 100 }
    ],
    "DailyBudget": 50.0
  },
  "Pricing": {
    "CostPerMillionTokens": {
      "openai": 2.50
    }
  },
  "Cache": {
    "Provider": "Redis"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultExpirySeconds": 3600,
    "KeyPrefix": "agent-platform:"
  },
  "AutoGen": {
    "MaxRounds": 20,
    "MaxIdleIntervalSeconds": 30,
    "MaxRetryAttempts": 3,
    "DefaultModelId": "deepseek-chat"
  },
  "StateMachine": {
    "MaxRetryAttempts": 3,
    "StepTimeoutSeconds": 120,
    "RollbackTimeoutSeconds": 300,
    "AllowCriticOverride": false,
    "MaxSummaryTokens": 8000
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
