{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Type": "sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=agent_platform.db;Cache=Private",
    "PostgreSQL": "Host=localhost;Database=agent_platform;Username=postgres;Password=postgres"
  },
  "Tenant": {
    "DefaultTenantId": "00000000-0000-0000-0000-000000000001"
  },
  "ModelClient": {
    "Provider": "OpenAI"
  },
  "OpenAI": {
    "Key": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini"
  },
  "Rag": {
    "EmbeddingModel": "text-embedding-3-small",
    "DefaultTopK": 5,
    "DefaultMinScore": 0.7,
    "ChunkSizeTokens": 512,
    "ChunkOverlapTokens": 64
  },
  "Pricing": {
    "CostPerMillionTokens": {
      "openai": 2.50
    }
  },
  "Cache": {
    "Provider": "Memory"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultExpirySeconds": 3600,
    "KeyPrefix": "agent-platform:"
  },
  "AutoGen": {
    "MaxRounds": 20,
    "MaxIdleIntervalSeconds": 30,
    "MaxRetryAttempts": 3,
    "DefaultModelId": "deepseek-chat"
  },
  "StateMachine": {
    "MaxRetryAttempts": 3,
    "StepTimeoutSeconds": 120,
    "RollbackTimeoutSeconds": 300,
    "AllowCriticOverride": false,
    "MaxSummaryTokens": 8000
  },
  "DurableExecution": {
    "LeaseTtlMinutes": 5,
    "CheckpointBatchSize": 5,
    "CheckpointMaxAgeSeconds": 30
  },
  "AgentCollaboration": {
    "MaxMessagesPerRound": 64,
    "StallTimeoutSeconds": 120,
    "MaxAgentsParallel": 8,
    "LoopFingerprintThreshold": 3
  },
  "SemanticMemory": {
    "Enabled": true,
    "RecallTopK": 3,
    "RecallMinScore": 0.6
  },
  "Security": {
    "JwtIssuer": "agent-platform",
    "JwtAudience": "agent-platform-api",
    // DEV ONLY: 以下密钥仅用于本地/测试。生产环境必须由环境变量或密钥管理(如 Azure Key Vault / KMS)覆盖，切勿提交真实密钥。
    "JwtSecretKey": "dev-only-secret-key-please-override-in-prod-9f3a1c7e2b8d4a60",
    "ApiKeyHeaderName": "X-API-Key",
    // DEV ONLY: AES-256-GCM 32 字节密钥(base64)。生产必须由环境变量/密钥管理覆盖。
    "AesEncryptionKey": "Qnwv8CYcFeyp+nVU6nMxe4V6MyNAUN2IOyNcvErT7FI=",
    "EnforceAuthentication": true,
    // DEV ONLY: 开启后注册 POST /api/dev/login，可凭任意 tenant/role 签发 JWT（模拟登录）。
    // 仅供本地 Swagger/Scalar 测试，生产环境必须为 false，否则等于任意发 token。
    "DevLoginEnabled": false,
    "RateLimitPerMinute": 100
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Sandbox": {
    "Provider": "Docker",
    "TimeoutSeconds": 30,
    "HttpTimeoutSeconds": 15,
    "AllowedLanguages": [ "python", "javascript" ],
    "NetworkEnabled": false,
    "MaxOutputBytes": 65536,
    "OsIsolation": "JobObject",
    "MaxProcessCount": 16,
    "MemoryLimitBytes": 268435456,
    "CpuRatePercent": 50
  },
  "Routing": {
    // 注意：此段当前未被 RouterSettings 绑定（RouterSettings 绑定 "Router" 段，且
    // TimeoutSeconds 默认 0 = 禁用单次调用超时）。保留以防后续接入，0 表示无限。
    "TimeoutSeconds": 0,
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 500,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerBreakDurationSeconds": 30
  },
  "Search": {
    "Provider": "SerpApi",
    "SerpApiKey": "",
    "BaseUrl": "https://serpapi.com/search.json",
    "TimeoutSeconds": 15,
    "DefaultMaxResults": 5
  }
}
