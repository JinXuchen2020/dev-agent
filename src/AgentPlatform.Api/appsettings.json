{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Type": "sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=agent_platform.db;Cache=Private",
    "PostgreSQL": "Host=localhost;Database=agent_platform;Username=postgres;Password=postgres"
  },
  "Tenant": {
    "DefaultTenantId": "00000000-0000-0000-0000-000000000001"
  },
  "ModelDefaults": {
    "ModelProvider": "deepseek",
    "ModelName": "deepseek-chat",
    "ModelApiUrl": "https://api.deepseek.com/v1",
    "SystemPrompt": "You are a helpful AI assistant."
  },
  "ModelClient": {
    "Provider": "OpenAI"
  },
  "OpenAI": {
    "Key": ""
  },
  "DeepSeek": {
    "Key": ""
  },
  "VLLM": {
    "Url": "",
    "Model": "local-llm"
  },
  "Router": {
    "Candidates": [
      { "ModelId": "deepseek-chat", "Provider": "deepseek", "Priority": 100 }
    ],
    "DailyBudget": 50.0
  },
  "Pricing": {
    "CostPerMillionTokens": {
      "deepseek": 0,
      "openai": 2.50
    }
  },
  "Cache": {
    "Provider": "Memory"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultExpirySeconds": 3600,
    "KeyPrefix": "agent-platform:"
  },
  "AutoGen": {
    "MaxRounds": 20,
    "MaxIdleIntervalSeconds": 30,
    "MaxRetryAttempts": 3,
    "DefaultModelId": "deepseek-chat"
  },
  "StateMachine": {
    "MaxRetryAttempts": 3,
    "StepTimeoutSeconds": 120,
    "RollbackTimeoutSeconds": 300,
    "AllowCriticOverride": false,
    "MaxSummaryTokens": 8000
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
